;; 部分实现特性全链路化综合示例(CLP 算术/多解溯因/HoTT/类型一等值/多模式)
;; 运行:tisp --typecheck partial-completion-demo.tisp

;; §21.5 CLP 算术约束:乘法 + all-different
(defn clp-demo []
  (fresh [x y z]
    (domain x 1 6)
    (domain y 1 6)
    (constrain (= (* x y) 12))
    (label x 1)
    (label y 1)
    (println (+ (* x 10) y))))

;; §21.6 ALP 多解枚举:abduce 返回全部一致解释
(defn abduce-demo []
  (fresh [x]
    (domain x 1 3)
    (println (count (abduce (constrain (> x 1)) x)))))

;; §16/17 HoTT:Transp 端点传输 + Shape 路径连通
(defn hott-demo []
  (println (transp (fn [i] 9) true))
  (println (shape (fn [i] 42))))

;; §9 类型一等值:reflect-type 返回类型值(可比较)
(defn type-demo [x : i64] -> i64 x)

(defn main []
  (clp-demo)
  (abduce-demo)
  (hott-demo)
  (println (= (reflect-type type-demo) (reflect-type type-demo))))
