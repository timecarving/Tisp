;; ch01-datatypes.tisp — 基本数据类型
;; ✅ 可运行  $ tisp --run tutorial/examples/ch01-datatypes.tisp
;; ✅ 可类型检查  $ tisp --typecheck tutorial/examples/ch01-datatypes.tisp
(defn main []
  (println 42)
  (println "hello")
  (println (range 1 4))
  (println (cons 1 2))
  (println (and true false))
  (println (or true false)))