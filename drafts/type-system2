Basic Type
type的签名 type接收一个 => Trait或者是已知的类型 进行名字的绑定
(type A B) ;;;define type alias A
(type A
  (conj B C)) ;;;define Tuple Type (B C)
(type A
  (disj B C)) ;;;define A can be B or C
(type Boolean
  (disj Unit Void))
Trait
(trait
  (fn members [...] ()...)
  (type ...))
(polytrait
  ['a 'b 'c ...]
  (type ...)) ;;;和trait同理 使用的时候需要用[]括号 polytrait默认是polytype的trait会自带这个特性 polytrait可以被普通type with
(type Demo01
  (conj I32 F32)
  (with Traits
    (fn member01)
    (fn member02))
  (with Traits02)
  (with (fn member01)...)
  (with-static (fn static-member01) ...)
  (with-cons (fn ...)))
  
